# ─────────────────────────────────────────────────────────────
# OpenChurch environment configuration
# Copy to .env and adjust. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# Database — Prisma connection string.
#
# Development (default): local SQLite file, zero setup. The committed schema
# provider is "sqlite" — nothing else to configure.
DATABASE_URL="file:./db/custom.db"
#
# PostgreSQL (recommended for production, REQUIRED on serverless hosts such
# as Vercel — their filesystem is ephemeral and cannot persist a SQLite file):
#   1. run  npm run use:postgres   (flips prisma/schema.prisma to postgresql)
#   2. point DATABASE_URL at your server.
#
# Neon serverless Postgres (https://neon.tech) provides TWO connection strings
# — use BOTH on serverless platforms:
#   DATABASE_URL  → the POOLED string (host contains "-pooler"), used by the
#                   app at runtime; append &pgbouncer=true so Prisma disables
#                   prepared statements the pooler cannot handle.
#   DIRECT_URL    → the DIRECT string (no "-pooler"), used by migrations —
#                   see scripts/vercel-build.sh.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/openchurch?sslmode=require&pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/openchurch?sslmode=require"
#
# Self-managed Postgres (Docker/RDS/Supabase) can use one URL for both:
# DATABASE_URL="postgresql://user:password@localhost:5432/openchurch"

# Canonical public URL of this deployment — used for canonical links,
# Open Graph / Twitter metadata, sitemaps and robots.txt. No trailing slash.
# IMPORTANT: set this to the real public origin (https) in every production
# deployment. Reverse proxies that rewrite the Host header make request-based
# origin detection unreliable, so this variable is the authoritative source.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Legacy alias — still honoured when it points at a public origin, but
# NEXT_PUBLIC_SITE_URL takes precedence.
# NEXT_PUBLIC_APP_URL=""

# Public repository URL — when set, the landing page's source button links to
# your repository (otherwise it scrolls to the in-page open-source section).
# NEXT_PUBLIC_REPO_URL="https://github.com/your-org/openchurch"

# Deployment mode for church URL routing:
#   PATH   — churches are served at /church/<slug> (works everywhere)
#   HOST   — subdomain/custom-domain routing; requires DNS control and the
#            reverse-proxy setup described in docs/DEPLOYMENT.md
DEPLOYMENT_MODE="PATH"

# Only used in HOST mode: the platform's own root domain, e.g. openchurch.example
# PLATFORM_ROOT_DOMAIN="openchurch.example"

# Local file storage for the media library (absolute or relative to project root).
STORAGE_PATH="./storage/uploads"

# ─────────────────────────────────────────────────────────────
# Optional integrations (NOT REQUIRED — everything below is
# optional and the platform runs without any of it configured)
# ─────────────────────────────────────────────────────────────

# Giving via external payment pages (Paystack / Stripe Payment Links).
# These are ordinary URLs configured per church in the dashboard —
# OpenChurch never processes cards and needs NO API keys for this.
# Direct provider API integrations are planned; keys would go here, and
# ONLY in server-side environment variables (never NEXT_PUBLIC_*).
# PAYSTACK_SECRET_KEY=""
# STRIPE_SECRET_KEY=""

# Server-side demonstration mode (NOT a NEXT_PUBLIC_ variable — access
# control must never live in the client bundle). When "true", the sign-in
# page may show the demonstration accounts the seed script created AND those
# accounts can authenticate. Defaults: true in development, FALSE in
# production when unset (fail safe). Never enable on a real production
# instance — demo accounts are blocked server-side while this is false.
DEMO_MODE="false"
# Seed demo churches/accounts (evaluations & development only; seeding also
# requires demonstration mode to be enabled):
# SEED_DEMO_DATA="true"

# Email delivery for password-reset emails. Until an SMTP server is
# configured, /forgot-password honestly states that email delivery is
# unavailable and directs users to their platform administrator.
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# Email messages are sent from this address:
# MAIL_FROM="OpenChurch <no-reply@example.com>"

# Custom-domain hosting integration (managed hosting on Vercel). When BOTH
# are set, church owners get automated domain assignment from the dashboard:
# the domain is attached to the Vercel project, the provider's required DNS
# records are shown, and status comes from the provider API.
# Server-side only — never expose these tokens to the browser.
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""

# Custom-domain capability override (optional). Derived automatically when
# unset: provider tokens above → automated managed-hosting workflow;
# serverless runtime without them (VERCEL=1) → domains unavailable (the
# hosted-demonstration behaviour); always-on server → self-hosted manual
# workflow. Set it explicitly only for hosts the platform cannot detect
# (Coolify, Fly.io, Kubernetes, …). "auto" requires the provider tokens.
# CUSTOM_DOMAIN_MODE="manual"   # "auto" | "manual" | "off"

# Custom-domain plan limits (per-church plan is set by the platform
# administrator in /admin; limits apply deployment-wide). Defaults:
# free=0 (platform address only), paid=1, premium=10. No pricing is
# hardcoded — monetisation is the operator's choice.
# DOMAIN_LIMIT_FREE="0"
# DOMAIN_LIMIT_PAID="1"
# DOMAIN_LIMIT_PREMIUM="10"

# Secret for the scheduled domain recheck (GET /api/cron/domains — see
# vercel.json `crons`). When set, callers must send
# "Authorization: Bearer <CRON_SECRET>"; Vercel Cron injects it
# automatically. Generate e.g. with: openssl rand -hex 24
# CRON_SECRET=""

# Analytics (privacy-respecting providers) — not integrated yet.
# ANALYTICS_PROVIDER=""
